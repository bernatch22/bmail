{
  // tsconfig.json — @bmail/server build config.
  //
  // Extends the shared monorepo options; references let `tsc -b` build the
  // engine/db/contract packages first and type-check against their .d.ts.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/contract" },
    { "path": "../../packages/db" },
    { "path": "../../packages/engine" }
  ]
}
