{
  // tsconfig.json — root solution file for `tsc -b`.
  //
  // It compiles nothing itself ("files": []); it only lists the projects to
  // build, in any order — TypeScript resolves the dependency graph from each
  // package's own references.
  //
  // Four libraries, four apps. The libraries are grouped by who consumes
  // them: core is the engine, sdk builds clients, react draws them, admin
  // operates the platform.
  "files": [],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/sdk" },
    { "path": "packages/react" },
    { "path": "packages/admin" },
    { "path": "apps/server" },
    { "path": "apps/web" },
    { "path": "apps/cli" },
    { "path": "apps/mcp" }
  ]
}
