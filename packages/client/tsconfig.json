{
  // @bmail/client — SDK over the HTTP/WS API; depends only on @bmail/contract.
  // Tests live in test/*.test.mjs and import the built dist (same convention
  // as @bmail/domain), so only src/ is compiled here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "references": [
    { "path": "../contract" }
  ]
}
